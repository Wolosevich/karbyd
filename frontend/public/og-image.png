<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <defs>
    <radialGradient id="bg" cx="50%" cy="40%" r="80%">
      <stop offset="0%" stop-color="#1e1b4b"/>
      <stop offset="50%" stop-color="#0f0d2e"/>
      <stop offset="100%" stop-color="#050510"/>
    </radialGradient>
    <linearGradient id="logoGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#818cf8"/>
      <stop offset="100%" stop-color="#c084fc"/>
    </linearGradient>
    <linearGradient id="textGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="100%" stop-color="#c7d2fe"/>
    </linearGradient>
    <filter id="glow">
      <feGaussianBlur stdDeviation="40" result="blur"/>
      <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
  </defs>

  <!-- Фон -->
  <rect width="1200" height="630" fill="url(#bg)"/>

  <!-- Свечение -->
  <circle cx="250" cy="200" r="220" fill="#6366f1" opacity="0.25" filter="url(#glow)"/>
  <circle cx="950" cy="450" r="260" fill="#a855f7" opacity="0.20" filter="url(#glow)"/>

  <!-- Сетка из точек -->
  <g fill="#ffffff" opacity="0.06">
    <circle cx="100" cy="80" r="2"/><circle cx="200" cy="80" r="2"/><circle cx="300" cy="80" r="2"/>
    <circle cx="400" cy="80" r="2"/><circle cx="500" cy="80" r="2"/><circle cx="600" cy="80" r="2"/>
    <circle cx="700" cy="80" r="2"/><circle cx="800" cy="80" r="2"/><circle cx="900" cy="80" r="2"/>
    <circle cx="1000" cy="80" r="2"/><circle cx="1100" cy="80" r="2"/>
    <circle cx="100" cy="560" r="2"/><circle cx="200" cy="560" r="2"/><circle cx="300" cy="560" r="2"/>
    <circle cx="400" cy="560" r="2"/><circle cx="500" cy="560" r="2"/><circle cx="600" cy="560" r="2"/>
    <circle cx="700" cy="560" r="2"/><circle cx="800" cy="560" r="2"/><circle cx="900" cy="560" r="2"/>
    <circle cx="1000" cy="560" r="2"/><circle cx="1100" cy="560" r="2"/>
  </g>

  <!-- Логотип KD -->
  <g transform="translate(80, 90)">
    <rect width="110" height="110" rx="28" fill="url(#logoGrad)" opacity="0.15"/>
    <rect x="2" y="2" width="106" height="106" rx="26" fill="none" stroke="url(#logoGrad)" stroke-width="2" opacity="0.6"/>
    <text x="55" y="75" font-family="'Segoe UI', Arial, sans-serif" font-size="52"
          font-weight="800" fill="url(#logoGrad)" text-anchor="middle" letter-spacing="1">KD</text>
  </g>

  <!-- Название karbyd -->
  <text x="80" y="360" font-family="'Segoe UI', Arial, sans-serif"
        font-size="170" font-weight="900" fill="url(#textGrad)" letter-spacing="-4">
    karbyd
  </text>

  <!-- Подчёркивание -->
  <rect x="80" y="400" width="160" height="6" rx="3" fill="url(#logoGrad)"/>

  <!-- Подзаголовок -->
  <text x="80" y="480" font-family="'Segoe UI', Arial, sans-serif"
        font-size="30" font-weight="400" fill="#c7d2fe" opacity="0.85">
    Мини-социальная сеть для общения
  </text>
  <text x="80" y="525" font-family="'Segoe UI', Arial, sans-serif"
        font-size="30" font-weight="400" fill="#c7d2fe" opacity="0.85">
    и обмена фотографиями
  </text>

  <!-- Декоративный акцент справа -->
  <g transform="translate(980, 300)" opacity="0.5">
    <circle cx="0" cy="0" r="90" fill="none" stroke="url(#logoGrad)" stroke-width="2"/>
    <circle cx="0" cy="0" r="60" fill="none" stroke="url(#logoGrad)" stroke-width="1.5" opacity="0.6"/>
    <circle cx="0" cy="0" r="30" fill="url(#logoGrad)" opacity="0.3"/>
  </g>
</svg>